{
  "name": "ssh-bridge-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local agent that exposes SSH + rsync operations to the SSH Bridge web UI over HTTP + WebSocket.",
  "scripts": {
    "start": "node src/server.js",
    "start:lan": "HOST=0.0.0.0 PUBLIC_HOST=192.168.1.179 node src/server.js",
    "dev": "node --watch src/server.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.1.0",
    "ssh2": "^1.16.0"
  }
}
